---
import '../styles/global.css';
import AdSenseHead from '../components/AdSenseHead.astro';
import { getSiteSettings, resolveNavHref, isExternalHref } from '../utils/site-settings';
import { getSiteIntegrationSnippets } from '../utils/site-integrations';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const site = getSiteSettings();
const {
  title = site.title,
  description = '전기요금 지원금·소상공인 전기지원금·에너지바우처 신청·조회 정보를 모아 안내합니다.',
  path = Astro.url.pathname,
} = Astro.props;

// 키워드 선행: 네이버 연관검색(전기요금 지원금·신청) 기준, 브랜드는 뒤로
const fullTitle =
  title === site.title ? '전기요금 지원금 신청 안내 | 한전넷' : `${title} | ${site.title}`;
const siteOrigin = Astro.site?.origin ?? site.site_url;
const canonicalUrl = new URL(path || '/', siteOrigin).toString();
const ogImageUrl = new URL('/og.jpg', siteOrigin).toString();
const year = new Date().getFullYear();
const nav = site.nav.length
  ? site.nav.map((item) => ({
      href: resolveNavHref(item),
      label: item.label,
      external: isExternalHref(resolveNavHref(item)),
    }))
  : [
      { href: '/', label: '홈', external: false },
      { href: '/find/', label: '지원금 찾기', external: false },
      { href: '/benefits/', label: '혜택 목록', external: false },
      { href: '/guides/', label: '가이드', external: false },
    ];
const integrationSnippets = getSiteIntegrationSnippets();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f4ef" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="960" />
    <meta property="og:image:height" content="540" />
    <meta property="og:image:alt" content="전기요금 지원금 신청안내 — 한전넷" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`전기요금 지원금 | ${site.title}`} href="/rss.xml" />
    <title>{fullTitle}</title>
    {integrationSnippets.map((html) => <Fragment set:html={html} />)}
    <AdSenseHead />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/">
          <img
            class="brand__logo"
            src="/logo.png"
            alt=""
            width="36"
            height="36"
            decoding="async"
            fetchpriority="high"
          />
          <span class="brand__text">
            <span class="brand__name">{site.title}</span>
            <span class="brand__tag">전기요금 지원금 안내</span>
          </span>
        </a>
        <nav class="nav" aria-label="주요">
          {
            nav.map((item) => (
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                aria-current={
                  !item.external &&
                  (path === item.href || (item.href !== '/' && path.startsWith(item.href)))
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button
          class="menu-btn"
          type="button"
          id="menu-btn"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="메뉴 열기"
        >
          <span class="menu-btn__bars" aria-hidden="true"></span>
        </button>
      </div>
      <div class="mobile-nav" id="mobile-nav" hidden>
        <div class="container mobile-nav__inner">
          {
            nav.map((item) => (
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                aria-current={
                  !item.external &&
                  (path === item.href || (item.href !== '/' && path.startsWith(item.href)))
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <script is:inline>
      (function () {
        var btn = document.getElementById('menu-btn');
        var panel = document.getElementById('mobile-nav');
        if (!btn || !panel) return;

        function setOpen(open) {
          panel.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
          btn.classList.toggle('is-open', open);
          document.body.classList.toggle('nav-open', open);
        }

        btn.addEventListener('click', function () {
          setOpen(panel.hidden);
        });
        panel.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', function () {
            setOpen(false);
          });
        });
      })();
    </script>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-copy">
          © {year}{' '}
          <a class="footer-brand" href={site.site_url}>{site.copyright_name}</a>
          {' · '}
          <a class="footer-brand" href="/about/">소개</a>
        </p>
        <p class="footer-note">
          한전넷은 한국전력과 관련없는 개인 웹사이트이며, 본 사이트는 한국전력공사·정부와 제휴·공식 관계가 없는
          비공식 안내용 사이트입니다. 지원 자격·금액·신청은 보조금24·한전ON 등 원문에서 확인해 주세요.
        </p>
      </div>
    </footer>
  </body>
</html>
